<?xml version="1.0"?>
<sdf version="1.10">
  <model name="wheeled_office_chair">
    <static>false</static>
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>

    <!-- Main chair body. Keep mass moderate so Piper arm can move it in sim. -->
    <link name="chair_body">
      <pose>0 0 0.47 0 0 0</pose>
      <inertial>
        <mass>8.0</mass>
        <inertia>
          <ixx>0.45</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.45</iyy><iyz>0</iyz>
          <izz>0.35</izz>
        </inertia>
      </inertial>

      <!-- Seat -->
      <visual name="seat_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>0.58 0.58 0.08</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
      <collision name="seat_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>0.58 0.58 0.08</size></box></geometry>
        <surface>
          <friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction>
        </surface>
      </collision>

      <!-- Backrest -->
      <visual name="back_visual">
        <pose>-0.25 0 0.34 0.18 0 0</pose>
        <geometry><box><size>0.08 0.58 0.62</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
      <collision name="back_collision">
        <pose>-0.25 0 0.34 0.18 0 0</pose>
        <geometry><box><size>0.08 0.58 0.62</size></box></geometry>
      </collision>

      <!-- Center column -->
      <visual name="column_visual">
        <pose>0 0 -0.25 0 0 0</pose>
        <geometry><cylinder><radius>0.045</radius><length>0.50</length></cylinder></geometry>
        <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
      </visual>
      <collision name="column_collision">
        <pose>0 0 -0.25 0 0 0</pose>
        <geometry><cylinder><radius>0.045</radius><length>0.50</length></cylinder></geometry>
      </collision>

      <!-- Five-star base approximated using thin bars -->
      <visual name="base_bar_x_visual"><pose>0 0 -0.50 0 0 0</pose><geometry><box><size>0.85 0.06 0.04</size></box></geometry></visual>
      <collision name="base_bar_x_collision"><pose>0 0 -0.50 0 0 0</pose><geometry><box><size>0.85 0.06 0.04</size></box></geometry></collision>
      <visual name="base_bar_y_visual"><pose>0 0 -0.50 0 0 1.5708</pose><geometry><box><size>0.85 0.06 0.04</size></box></geometry></visual>
      <collision name="base_bar_y_collision"><pose>0 0 -0.50 0 0 1.5708</pose><geometry><box><size>0.85 0.06 0.04</size></box></geometry></collision>
    </link>

    <!-- Passive low-friction caster approximations. These are small spheres, not driven wheels. -->
    <link name="caster_fl">
      <pose>0.33 0.33 0.07 0 0 0</pose>
      <inertial><mass>0.25</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
      <visual name="visual"><geometry><sphere><radius>0.055</radius></sphere></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material></visual>
      <collision name="collision"><geometry><sphere><radius>0.055</radius></sphere></geometry><surface><friction><ode><mu>0.08</mu><mu2>0.08</mu2></ode></friction></surface></collision>
    </link>
    <joint name="caster_fl_joint" type="fixed"><parent>chair_body</parent><child>caster_fl</child><pose relative_to="chair_body">0.33 0.33 -0.40 0 0 0</pose></joint>

    <link name="caster_fr">
      <pose>0.33 -0.33 0.07 0 0 0</pose>
      <inertial><mass>0.25</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
      <visual name="visual"><geometry><sphere><radius>0.055</radius></sphere></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material></visual>
      <collision name="collision"><geometry><sphere><radius>0.055</radius></sphere></geometry><surface><friction><ode><mu>0.08</mu><mu2>0.08</mu2></ode></friction></surface></collision>
    </link>
    <joint name="caster_fr_joint" type="fixed"><parent>chair_body</parent><child>caster_fr</child><pose relative_to="chair_body">0.33 -0.33 -0.40 0 0 0</pose></joint>

    <link name="caster_rl">
      <pose>-0.33 0.33 0.07 0 0 0</pose>
      <inertial><mass>0.25</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
      <visual name="visual"><geometry><sphere><radius>0.055</radius></sphere></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material></visual>
      <collision name="collision"><geometry><sphere><radius>0.055</radius></sphere></geometry><surface><friction><ode><mu>0.08</mu><mu2>0.08</mu2></ode></friction></surface></collision>
    </link>
    <joint name="caster_rl_joint" type="fixed"><parent>chair_body</parent><child>caster_rl</child><pose relative_to="chair_body">-0.33 0.33 -0.40 0 0 0</pose></joint>

    <link name="caster_rr">
      <pose>-0.33 -0.33 0.07 0 0 0</pose>
      <inertial><mass>0.25</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
      <visual name="visual"><geometry><sphere><radius>0.055</radius></sphere></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material></visual>
      <collision name="collision"><geometry><sphere><radius>0.055</radius></sphere></geometry><surface><friction><ode><mu>0.08</mu><mu2>0.08</mu2></ode></friction></surface></collision>
    </link>
    <joint name="caster_rr_joint" type="fixed"><parent>chair_body</parent><child>caster_rr</child><pose relative_to="chair_body">-0.33 -0.33 -0.40 0 0 0</pose></joint>
  </model>
</sdf>
