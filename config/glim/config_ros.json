{
  "glim_ros": {
    "enable_local_mapping": true,
    "enable_global_mapping": true,
    "keep_raw_points": false,
    "imu_time_offset": 0.0,
    "points_time_offset": 0.0,
    "acc_scale": 1.0,
    "imu_frame_id": "imu_link",
    "lidar_frame_id": "lidar_front_link",
    "base_frame_id": "base_footprint",
    "odom_frame_id": "odom",
    "map_frame_id": "map",
    "publish_imu2lidar": false,
    "tf_time_offset": 0.0,
    "extension_modules": [
      "libmemory_monitor.so",
      "libstandard_viewer.so",
      "librviz_viewer.so"
    ],
    "imu_topic": "/imu/data",
    "points_topic": "/lidar_front/points",
    "image_topic": "/camera_front/image",
    "imu_qos": {
      "profile": "sensor_data",
      "depth": 1000
    },  
    "points_qos": {
      "profile": "sensor_data",
      "depth": 10
    },
    "image_qos": {
      "profile": "sensor_data",
      "depth": 5
    }
  }
}
